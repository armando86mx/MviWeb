---
import { Image } from 'astro:assets';
import articleCover from '@assets/img/blog/el-celo-por-tu-casa.png';
import { activeSeason } from '@lib/season';
import SeasonFlame from './SeasonFlame.astro';
---

{activeSeason && (
  <section class="season-banner" aria-labelledby="season-banner-title" data-season-banner>
    <div class="container container--cta">
      <div class="season-banner__band">
        <div class="season-banner__copy">
          <p class="season-banner__label"><SeasonFlame size={18} /> Serie actual</p>
          <h2 id="season-banner-title">{activeSeason.title}</h2>
          <p class="season-banner__description">{activeSeason.description}</p>
          <p class="season-banner__meta">
            <span>{activeSeason.scripture}</span>
            <span aria-hidden="true">·</span>
            <span>{activeSeason.meetingLabel}</span>
          </p>
        </div>
        <a
          class="season-banner__article"
          href={`/blog/${activeSeason.articleSlug}`}
          aria-label={`Leer ${activeSeason.title} en el blog`}
        >
          <figure>
            <Image
              src={articleCover}
              alt="Una casa con la puerta iluminada, una golondrina y su nido."
              widths={[480, 720, 960]}
              sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 1079px) 42vw, 435px"
              format="webp"
              loading="lazy"
              class="season-banner__image"
            />
            <figcaption>{activeSeason.articleLabel}</figcaption>
          </figure>
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .season-banner {
    padding-block: var(--sp-2) var(--sp-6);
  }

  .season-banner__band {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: var(--sp-5);
    border-block: 1px solid var(--border-amber);
  }

  .season-banner__label {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--ochre-600);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .season-banner__copy h2 {
    margin-top: var(--sp-2);
    text-wrap: balance;
  }

  .season-banner__description {
    margin-top: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }

  .season-banner__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
    font-size: var(--fs-xs);
    color: var(--ochre-600);
  }

  .season-banner__article {
    display: block;
    min-width: 0;
    color: var(--ochre-600);
    text-decoration: none;
    border-radius: var(--radius-photo);
  }

  .season-banner__article figure {
    margin: 0;
  }

  .season-banner__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 40 / 21;
    object-fit: contain;
    border-radius: var(--radius-photo);
  }

  .season-banner__article figcaption {
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .season-banner__article:hover {
    color: var(--ochre-700);
  }

  @media (max-width: 639px) {
    .season-banner {
      padding-block: 0 var(--sp-3);
    }

    .season-banner__band {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-5);
    }
  }

  @media (min-width: 768px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .season-banner--entered .season-banner__band {
      animation: season-banner-enter 650ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes season-banner-enter {
    from { opacity: 0.78; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const banner = document.querySelector<HTMLElement>('[data-season-banner]');
  const motionAllowed = window.matchMedia(
    '(min-width: 768px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
  );

  if (banner && motionAllowed.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        banner.classList.add('season-banner--entered');
        observer.disconnect();
      }
    }, { threshold: 0.15 });

    observer.observe(banner);
  }
</script>

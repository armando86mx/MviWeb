---
import { activeSeason } from '@lib/season';
import SeasonFlame from './SeasonFlame.astro';
---

{activeSeason && (
  <div class="season-note">
    <SeasonFlame />
    <div>
      <span class="season-note__label">Serie actual</span>
      <strong class="season-note__title">{activeSeason.title}</strong>
    </div>
  </div>
)}

<style>
  .season-note {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--paper-line-2);
    color: var(--ochre-600);
  }

  .season-note__label {
    display: block;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .season-note__title {
    display: block;
    margin-top: var(--sp-1);
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-medium);
    line-height: 1.15;
    color: var(--blue-700);
  }
</style>

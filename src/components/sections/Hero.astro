---
import Button from '@components/ui/Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  /** Línea final del H1 en itálica de acento (la firma del estilo). */
  titleAccent?: string;
  subtitle?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
}

const { eyebrow, title, titleAccent, subtitle, primaryCTA, secondaryCTA } = Astro.props;
---

<section class="hero hero--page" aria-labelledby="hero-heading">
  <div class="container container--cta hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 id="hero-heading" class="hero__title text-balance">
      {title}
      {titleAccent && <em class="hero__accent">{titleAccent}</em>}
    </h1>
    {subtitle && <p class="hero__subtitle text-pretty">{subtitle}</p>}

    {(primaryCTA || secondaryCTA) && (
      <div class="hero__ctas">
        {primaryCTA && <Button variant="primary" size="lg" href={primaryCTA.href}>{primaryCTA.label}</Button>}
        {secondaryCTA && <Button variant="secondary" size="lg" href={secondaryCTA.href}>{secondaryCTA.label} <span aria-hidden="true">→</span></Button>}
      </div>
    )}
  </div>
</section>

<style>
  /* ── §7.3 · HERO OSCURO — páginas interiores (la home usa HeroSlider) ── */
  .hero {
    position: relative;
    background: var(--warm-hero-dark);
    color: var(--cream-text);
  }
  .hero__inner {
    padding-block: clamp(5.625rem, 8vw, 7rem); /* ~90-112px */
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--fs-4xl);
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--cream-text);
    margin-bottom: var(--sp-4);
  }
  .hero__accent {
    font-style: italic;
    color: var(--amber-400);
  }
  .hero__subtitle {
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--slate-text);
    max-width: 620px;
    margin-bottom: var(--sp-6);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    align-items: center;
  }
</style>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import CTABand from '@components/sections/CTABand.astro';
import SchemaChurch from '@components/seo/SchemaChurch.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import MapaEmbed from '@components/ui/MapaEmbed.astro';
import { SITE } from '@lib/site';

const sede = SITE.sedes.tehuacan;

const title = 'Tzion Life · Iglesia Cristiana en Tehuacán, Puebla · Amor y Gracia';
const description = 'Tzion Life, iglesia asociada de MVI Amor y Gracia en Tehuacán, Puebla. Iglesia evangélica con sana doctrina, en comunión con la sede principal de Amozoc.';
---

<BaseLayout title={title} description={description} path="/sedes/tehuacan">
  <SchemaChurch slot="head" variant="tehuacan" />
  <SchemaBreadcrumb
    slot="head"
    items={[
      { name: 'Inicio', href: '/' },
      { name: 'Sede Tehuacán', href: '/sedes/tehuacan' },
    ]}
  />

  <Hero
    eyebrow="Iglesia asociada · Tehuacán"
    title="Tzion Life, Iglesia Cristiana Evangélica en Tehuacán"
    subtitle="Tzion Life es una iglesia asociada en Tehuacán, Puebla. Con su propio liderazgo local, en comunión con la sede principal de Amozoc."
  />

  <section class="section">
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Inicio', href: '/' },
        { label: 'Sede Tehuacán' },
      ]} />
    </div>
    <div class="container container--prose stack-lg mt-5">
      <p class="eyebrow">Quiénes somos en Tehuacán</p>
      <h2>Una iglesia local, plantada con calma.</h2>
      <p>
        La iglesia Tzion Life en Tehuacán es <strong>iglesia asociada</strong> de MVI Amor y Gracia. Eso
        significa que es una congregación local, con su propio liderazgo y vida en comunidad,
        pero en comunión doctrinal y pastoral con la sede principal en Amozoc.
      </p>
      <p>
        Si vives en Tehuacán, Tepanco de López, San Sebastián Zinacatepec, Ajalpan o municipios
        cercanos, esta es tu iglesia local. Compartimos los mismos pilares, la misma sana
        doctrina y el mismo énfasis en la mesa y la profundidad.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="grid grid--2 sede">
        <article class="info">
          <p class="eyebrow">Cómo llegar</p>
          <h2>Dirección y horario</h2>
          <dl class="datos">
            <div>
              <dt>Dirección</dt>
              <dd><strong>Tzion Life</strong><br />{sede.fullAddress}</dd>
            </div>
            <div>
              <dt>Horario</dt>
              <dd>Domingos · 10:00 AM</dd>
            </div>
            <div>
              <dt>Correo</dt>
              <dd><a href={`mailto:${sede.email}`}>{sede.email}</a></dd>
            </div>
            <div>
              <dt>Sitio web</dt>
              <dd><a href={sede.website} target="_blank" rel="noopener noreferrer">tzionlife.org<span class="sr-only"> (se abre en ventana nueva)</span></a></dd>
            </div>
          </dl>
          <p class="acciones">
            <Button variant="primary" href={sede.mapsUrl} target="_blank" rel="noopener noreferrer">
              Cómo llegar<span class="sr-only"> (se abre en ventana nueva)</span>
            </Button>
            <Button variant="ghost" href={`mailto:${sede.email}`}>Escribir a la iglesia →</Button>
          </p>
        </article>

        <div class="sede__mapa">
          <MapaEmbed sede={sede} title="Mapa: Tzion Life, C. 11 Nte. 433, San Pedro Acoquiaco, Tehuacán" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2 sede">
        <header class="info">
          <p class="eyebrow">Liderazgo local</p>
          <h2>Pastores de Tzion Life Tehuacán</h2>
          <p class="lead">
            La iglesia de Tehuacán cuenta con su propio liderazgo, con conocimiento de la zona
            y experiencia ministerial, en comunión con los pastores Daniel y Rocío Chávez.
          </p>
          <p>
            Si quieres conocerlos, <a href={`mailto:${sede.email}`}>escríbenos</a> y con gusto los saludas
            en persona.
          </p>
        </header>

        <Card>
          <ul class="pastores">
            <li>
              <span class="pastores__rol">Pastor</span>
              <strong class="pastores__nombre">Mizael Reyes Frías</strong>
            </li>
            <li>
              <span class="pastores__rol">Pastora</span>
              <strong class="pastores__nombre">Patricia Arriaga Martínez</strong>
            </li>
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="Visítanos"
    title="Ven a conocer la iglesia Tzion Life en Tehuacán."
    subtitle="Si vives en la zona y estás buscando iglesia, escríbenos y te recibimos personalmente. Sin presión, sin requisitos."
    primaryCTA={{ label: 'Escríbenos', href: `mailto:${sede.email}` }}
    secondaryCTA={{ label: 'Qué esperar en tu visita', href: '/contacto#primera-visita' }}
  />
</BaseLayout>

<style>
  .sede { align-items: stretch; }
  .info { display: flex; flex-direction: column; gap: var(--sp-4); }
  .datos { display: flex; flex-direction: column; gap: var(--sp-4); margin: 0; }
  .datos > div {
    padding: var(--sp-4);
    background: var(--paper-100);
    border: 1.5px solid var(--paper-line);
    border-radius: var(--radius-sm);
  }
  .datos dt {
    font-size: var(--fs-sm);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-1);
  }
  .datos dd { margin: 0; line-height: var(--lh-relaxed); color: var(--ink); }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--sp-3); align-items: center; margin: 0; }
  /* El mapa ocupa toda la altura de la columna (en celular vuelve a 16:9) */
  .sede__mapa :global(.mapa) { height: 100%; min-height: 320px; aspect-ratio: auto; }
  @media (max-width: 767px) {
    .sede__mapa :global(.mapa) { aspect-ratio: 16 / 9; min-height: 0; height: auto; }
  }
  .pastores { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .pastores li { padding: var(--sp-4) 0; display: flex; flex-direction: column; gap: var(--sp-1); }
  .pastores li + li { border-top: 1.5px solid var(--paper-line); }
  .pastores__rol {
    font-size: var(--fs-sm);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pastores__nombre { font-family: var(--font-display); font-size: var(--fs-xl); color: var(--blue-700); font-weight: 400; }
</style>

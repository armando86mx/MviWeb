---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import Card from '@components/ui/Card.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SeasonFlame from '@components/season/SeasonFlame.astro';
import { activeSeason } from '@lib/season';

const title = 'Blog · MVI Amor y Gracia · Estudios bíblicos y reflexiones';
const description = 'Blog de MVI Amor y Gracia: estudios bíblicos, reflexiones sobre la segunda venida de Cristo, los 4 pilares de la iglesia, sana doctrina y vida en familia.';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.find((post) => post.slug === activeSeason?.articleSlug);
const remainingPosts = posts.filter((post) => post !== featured);

// timeZone UTC: pubDate llega como medianoche UTC; sin esto la fecha
// se corría un día hacia atrás al formatear en horario de México
const fmt = new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={title} description={description} path="/blog">
  <SchemaBreadcrumb slot="head" items={[{ name: 'Inicio', href: '/' }, { name: 'Blog', href: '/blog' }]} />

  <Hero
    eyebrow="Blog"
    decorated={Boolean(activeSeason)}
    title="Estudios y reflexiones desde Amor y Gracia"
    subtitle="Lo que estamos pensando, predicando y conversando como iglesia. Sin prisa, sin clickbait, con la Biblia abierta."
  >
    {activeSeason && (
      <span slot="decoration" class="blog-flame"><SeasonFlame size={56} /></span>
    )}
  </Hero>

  <section class="section">
    <div class="container">
      {featured && (
        <article class="featured-post">
          <div class="featured-post__heading">
            <p class="post-card__tags">Artículo destacado</p>
            <span class="featured-post__label">Reflexión sobre el Salmo 84</span>
          </div>
          {featured.data.heroImage && (
            <a href={`/blog/${featured.slug}`} class="featured-post__image-link" tabindex="-1" aria-hidden="true">
              <Image src={featured.data.heroImage} alt="" widths={[480, 768, 1200]}
                sizes="(max-width: 1152px) calc(100vw - 2rem), 1104px" class="featured-post__image" />
            </a>
          )}
          <div class="featured-post__copy">
            <p class="post-card__tags">Salmo 84 · Reflexión</p>
            <h2 class="featured-post__title"><a href={`/blog/${featured.slug}`}>{featured.data.title}</a></h2>
            <p class="post-card__desc">{featured.data.description}</p>
            <p class="post-card__meta">
              <time datetime={featured.data.pubDate.toISOString()}>{fmt.format(featured.data.pubDate)}</time>
              {featured.data.author && <span> · {featured.data.author}</span>}
            </p>
            <a href={`/blog/${featured.slug}`} class="featured-post__link">Leer la reflexión <span aria-hidden="true">→</span></a>
          </div>
        </article>
      )}
      {posts.length === 0 ? (
        <p class="muted">Estamos preparando los primeros estudios. Mientras tanto, conoce <a href="/recursos">la serie Crecer</a> o <a href="/contacto#primera-visita">visítanos un domingo</a>.</p>
      ) : (
        <ul class="post-list">
          {remainingPosts.map((post) => (
            <li>
              <Card href={`/blog/${post.slug}`}>
                {post.data.tags && post.data.tags.length > 0 && (
                  <p class="post-card__tags">
                    {post.data.tags.slice(0, 2).join(' · ')}
                  </p>
                )}
                <h2 class="post-card__title">{post.data.title}</h2>
                <p class="post-card__desc">{post.data.description}</p>
                <p class="post-card__meta">
                  <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
                  {post.data.author && <span> · {post.data.author}</span>}
                </p>
              </Card>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-flame { display: flex; justify-content: center; color: var(--amber-500); opacity: 0.74; }
  .blog-flame :global(svg) { stroke-width: 1.25px; }
  .featured-post { margin-bottom: var(--sp-8); padding-bottom: var(--sp-8); border-bottom: 1px solid var(--paper-line); }
  .featured-post__heading { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-4); }
  .featured-post__heading .post-card__tags { margin-bottom: 0; }
  .featured-post__label { color: var(--ink-muted); font-size: var(--fs-sm); }
  .featured-post__copy { padding-top: var(--sp-5); max-width: 820px; }
  .featured-post__image-link { display: block; }
  .featured-post__image { display: block; width: 100%; height: auto; border-radius: var(--radius-md); }
  .featured-post__title { font-size: var(--fs-2xl); margin-bottom: var(--sp-4); text-wrap: balance; }
  .featured-post__title a { color: inherit; text-decoration: none; }
  .featured-post__title a:hover { text-decoration: underline; text-underline-offset: 0.15em; }
  .featured-post__link { display: inline-flex; gap: var(--sp-2); align-items: center; min-height: 44px; margin-top: var(--sp-3); font-weight: var(--fw-semibold); }
  @media (max-width: 767px) {
    .featured-post__heading { flex-direction: column; align-items: flex-start; gap: var(--sp-1); }
    .blog-flame { position: absolute; left: var(--container-pad); top: clamp(5.625rem, 8vw, 7rem); }
    .blog-flame :global(svg) { width: 24px; height: 24px; }
  }
  .post-list {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
  }
  @media (min-width: 800px) { .post-list { grid-template-columns: repeat(2, 1fr); } }

  .post-card__tags {
    font-family: var(--font-body);
    font-weight: var(--fw-bold);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ochre-600);
    margin-bottom: var(--sp-3);
  }
  .post-card__title {
    font-size: var(--fs-xl);
    margin-bottom: var(--sp-3);
    text-wrap: balance;
  }
  .post-card__desc { color: var(--ink-body-80); line-height: var(--lh-relaxed); }
  .post-card__meta {
    margin-top: var(--sp-4);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--ink-muted);
  }
</style>

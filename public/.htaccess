# MVI Amor y Gracia — .htaccess de producción
# Vive en public/ para viajar con cada build (el rsync --delete no lo borra).
# Directivas conservadoras compatibles con Apache y LiteSpeed (Hostinger).

# Nuestro home manda: inmune a un index.php residual (p.ej. el "Próximamente"
# de Hostinger, que LiteSpeed prioriza por default y el deploy FTP no borra)
DirectoryIndex index.html index.php

# Sin el 301 automático "sin barra → con barra" de los directorios: las reglas de
# rewrite de abajo sirven /pagina/index.html directo. (LiteSpeed ignora esta
# directiva y evalúa el rewrite antes de su redirección, así que ahí no hace falta.)
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# ── Canónico: HTTPS + sin www (una sola forma de URL para SEO) ──
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Nada de .git servible por web (lo deja el clon del botón Desplegar de hPanel)
  RewriteRule ^\.git(/.*)?$ - [F,L]

  # Solo el dominio principal: este .htaccess se hereda hacia las carpetas
  # de los subdominios (p.ej. app/) y no debe redirigirlos.
  RewriteCond %{HTTP_HOST} ^(www\.)?amorygraciapuebla\.org$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://amorygraciapuebla.org%{REQUEST_URI} [L,R=301]

  # /visitanos se fusionó en /contacto (301 real; el HTML de respaldo
  # con meta-refresh queda para hosts sin mod_rewrite)
  RewriteRule ^visitanos/?$ /contacto [L,R=301]

  # El post de los pilares pasó de 5 a 4 (sep-2026): la URL vieja sigue viva
  RewriteRule ^blog/cinco-pilares-iglesia-primitiva-hechos-2-42/?$ /blog/cuatro-pilares-iglesia-primitiva-hechos-2-42 [L,R=301]

  # ── URLs canónicas SIN barra final (Astro: trailingSlash 'never') ──
  # Antes el servidor contestaba a /pagina con un 301 a /pagina/ (DirectorySlash)
  # en cada clic interno, mientras canonical y sitemap apuntan a la versión sin barra.
  # 1) /pagina/ → /pagina (301): consolida lo que Google ya indexó con barra.
  #    PASO 2: se activa cuando el hosting responda 200 a /pagina con la regla 2
  #    (si la regla 2 no aplicara, esta sola haría un bucle de redirecciones).
  # RewriteCond %{HTTP_HOST} ^(www\.)?amorygraciapuebla\.org$ [NC]
  # RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  # RewriteRule ^(.+)/$ /$1 [L,R=301]
  # 2) /pagina → sirve /pagina/index.html por dentro, sin redirigir.
  RewriteCond %{HTTP_HOST} ^(www\.)?amorygraciapuebla\.org$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+[^/])$ /$1/index.html [L]
</IfModule>

# El estado del deploy por FTP (GitHub Actions) no es público
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# ── Cabeceras de seguridad básicas ──
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Garantiza el MIME de las fuentes propias (el Expires de abajo depende de él)
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

# ── Caché por tipo: CSS/JS/webp de Astro van con hash en el nombre y las
#    fuentes de /fonts/ llevan versión — un año es seguro; el HTML siempre fresco ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>
